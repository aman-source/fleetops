# Fleetops Environment Variables
# Copy to .env and fill in values

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Postgres (PostGIS)
DATABASE_URL=postgresql://fleetops:fleetops_secret@localhost:5432/fleetops

# Redis
REDIS_URL=redis://localhost:6379

# MQTT (Mosquitto)
MQTT_URL=mqtt://localhost:1883

# MinIO (S3-compatible)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=fleetops_minio
MINIO_SECRET_KEY=fleetops_minio_secret
MINIO_BUCKET=fleetops
MINIO_USE_SSL=false

# JWT
JWT_SECRET=change-this-to-a-strong-secret-min-16-chars
JWT_REFRESH_SECRET=change-this-to-another-strong-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Logging
LOG_LEVEL=debug
