{
  "name": "fleetops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/infra/db/seed.ts",
    "db:seed-fleet": "tsx src/infra/db/seed-fleet.ts",
    "db:seed-ops": "tsx src/infra/db/seed-operations.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "test:e2e:up": "docker compose -f docker-compose.test.yml up -d --wait && DATABASE_URL=postgresql://fleetops:fleetops_secret@localhost:5433/fleetops_test pnpm db:push && DATABASE_URL=postgresql://fleetops:fleetops_secret@localhost:5433/fleetops_test pnpm db:seed && DATABASE_URL=postgresql://fleetops:fleetops_secret@localhost:5433/fleetops_test pnpm db:seed-fleet && DATABASE_URL=postgresql://fleetops:fleetops_secret@localhost:5433/fleetops_test pnpm db:seed-ops",
    "test:e2e:down": "docker compose -f docker-compose.test.yml down -v",
    "test:e2e": "cd e2e/web && pnpm exec playwright test",
    "test:e2e:journeys": "cd e2e/web && pnpm exec playwright test --project=journeys",
    "test:e2e:safety": "cd e2e/web && pnpm exec playwright test --project=safety",
    "test:e2e:tier3": "cd e2e/web && pnpm exec playwright test --project=tier3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/websocket": "^11.0.1",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.25.6",
    "cron-parser": "^5.5.0",
    "drizzle-orm": "^0.36.4",
    "expo-server-sdk": "^6.1.0",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.3",
    "mqtt": "^5.10.3",
    "nodemailer": "^8.0.7",
    "otplib": "^13.4.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "puppeteer": "^25.0.4",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "twilio": "^6.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.1",
    "@playwright/test": "^1.49.0",
    "drizzle-kit": "^0.30.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "ws": "^8.18.0"
  }
}
